{
  "name": "stop-ui-monorepo",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurkham/stop-ui-kit.git"
  },
  "scripts": {
    "dev": "pnpm tokens && pnpm --parallel --filter @stop-ui/tokens --filter @stop-ui/storybook dev",
    "tokens": "pnpm --filter @stop-ui/tokens build",
    "build": "pnpm --filter \"./packages/**\" build",
    "build:storybook": "pnpm tokens && pnpm --filter @stop-ui/storybook build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:package": "pnpm --filter \"./packages/**\" lint:package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "pnpm tokens && pnpm --filter @stop-ui/storybook test",
    "check:css": "node tooling/check-css.js && stylelint packages/styles/dist/styles.css",
    "css:update": "pnpm build && node tooling/check-css.js --update",
    "size": "size-limit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm lint:package && pnpm check:css && pnpm size",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@stop-ui/test-utils": "workspace:*",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.5",
    "stylelint": "18.0.0-next.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "safari >= 16.4",
    "chrome >= 111",
    "firefox >= 128"
  ]
}
