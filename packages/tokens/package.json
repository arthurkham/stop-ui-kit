{
  "name": "@stop-ui/tokens",
  "version": "0.0.0",
  "description": "Stop UI design tokens: W3C DTCG sources compiled to CSS custom properties, a Tailwind preset and typed JavaScript.",
  "license": "MIT",
  "author": "Artur Khomenko",
  "homepage": "https://github.com/arthurkham/stop-ui-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurkham/stop-ui-kit.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/arthurkham/stop-ui-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "tokens",
    "contrast.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node --watch-path=tokens --watch-path=contrast.json scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint:package": "node ../../tooling/lint-package.js"
  },
  "devDependencies": {
    "style-dictionary": "^5.7.1"
  }
}
