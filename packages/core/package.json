{
  "name": "@stop-ui/core",
  "version": "0.0.0",
  "description": "Framework-agnostic behavior and accessibility primitives for Stop UI.",
  "license": "MIT",
  "author": "Artur Khomenko",
  "homepage": "https://github.com/arthurkham/stop-ui-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurkham/stop-ui-kit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/arthurkham/stop-ui-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint:package": "node ../../tooling/lint-package.js"
  }
}
