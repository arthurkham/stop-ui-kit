{
  "name": "@stop-ui/react",
  "version": "0.0.0",
  "description": "Accessible, themeable React components built on Stop UI.",
  "license": "MIT",
  "author": "Artur Khomenko",
  "homepage": "https://github.com/arthurkham/stop-ui-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurkham/stop-ui-kit.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/arthurkham/stop-ui-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./styles.layer.css": "./dist/styles.layer.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint:package": "node ../../tooling/lint-package.js"
  },
  "dependencies": {
    "@stop-ui/core": "workspace:^",
    "@stop-ui/styles": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
