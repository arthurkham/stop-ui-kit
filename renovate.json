{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "automerge": false,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "major": {
    "dependencyDashboardApproval": true
  },
  "packageRules": [
    {
      "description": "Collect remaining non-major dev dependency updates into one weekly PR",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (non-major)"
    },
    {
      "description": "Dev dependencies: keep package.json ranges in sync with the lockfile",
      "matchDepTypes": ["devDependencies"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Runtime dependencies: keep ranges permissive for consumers, update the lockfile",
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Supported React versions are a product decision, not a routine update",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "Tailwind changes the generated CSS; always review these together",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**", "tailwind-merge"],
      "groupName": "Tailwind CSS"
    },
    {
      "matchPackageNames": ["storybook", "@storybook/**"],
      "groupName": "Storybook"
    },
    {
      "matchPackageNames": ["vitest", "@vitest/**", "jsdom", "@testing-library/**", "axe-core"],
      "groupName": "testing"
    },
    {
      "matchPackageNames": [
        "eslint",
        "@eslint/**",
        "typescript-eslint",
        "eslint-plugin-**",
        "eslint-config-**",
        "globals",
        "prettier"
      ],
      "groupName": "linting"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "React (development)"
    },
    {
      "description": "The compatibility story targets Bootstrap 3 specifically",
      "matchPackageNames": ["bootstrap"],
      "allowedVersions": "<4"
    },
    {
      "description": "The Changesets action major version must match the Changesets CLI major version",
      "matchPackageNames": ["@changesets/**", "changesets/action"],
      "groupName": "Changesets"
    }
  ]
}
